// Cloudflare Workers (static assets): serves the built website from dist/.
// Build command in Cloudflare: npm run build · Deploy command: npx wrangler deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bemyguestlodge-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
